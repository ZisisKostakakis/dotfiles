{
    "global": {
        "ask_for_confirmation_before_quitting": false,
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Change Left Command + Shift to act as a Hyper Key (Cmd + Option + Control + Shift)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": {
                                        "mandatory": ["left_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": {
                                        "mandatory": ["left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change Caps Lock to Left Control",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper + N/M for tmux pane navigation in Ghostty",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "com.mitchellh.ghostty"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "b",
                                        "modifiers": ["control"]
                                    },
                                    { "key_code": "1" }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "com.mitchellh.ghostty"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "m",
                                    "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "b",
                                        "modifiers": ["control"]
                                    },
                                    { "key_code": "2" }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 33398,
                        "vendor_id": 9306
                    },
                    "ignore": false,
                    "ignore_vendor_events": true,
                    "treat_as_built_in_keyboard": true
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}